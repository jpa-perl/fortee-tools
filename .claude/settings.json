{
  "env": {
    "WRANGLER_SEND_METRICS": "false"
  },
  "sandbox": {
    "excludedCommands": [
      "npm run test:e2e",
      "npm run test:e2e *",
      "npm --prefix fortee-reception run test:e2e",
      "npm --prefix fortee-reception run test:e2e *",
      "npx playwright test",
      "npx playwright test *"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "workers.cloudflare.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm/_cacache",
        "~/.npm/_npx",
        "~/Library/Caches/ms-playwright",
        "~/Library/Preferences/.wrangler/logs",
        "~/Library/Preferences/.wrangler/registry",
        "~/Library/Preferences/cloudflare/dev-registry"
      ]
    }
  }
}
